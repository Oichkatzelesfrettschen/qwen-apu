# Claude Code against the appliance's Anthropic Messages route.
#
# Source this from a shell that already holds the bearer, or copy it to a path
# outside the repository and fill the placeholders there. The appliance mints
# its bearer at $HOME/qwen-webui-state/api.key on the laptop; that file stays
# outside this tree, unprinted and uncommitted, and reaches the workstation as a
# 0600 file the shell reads.
#
# Every variable below is documented at https://code.claude.com/docs/en/env-vars
# and https://code.claude.com/docs/en/llm-gateway-connect.

# The endpoint Claude Code sends /v1/messages to. Pointing it at a host other
# than api.anthropic.com also disables MCP tool search by default and, from
# v2.1.196, Remote Control.
export ANTHROPIC_BASE_URL=http://qwen-laptop:8080

# The bearer. ANTHROPIC_AUTH_TOKEN becomes "Authorization: Bearer <value>",
# which is the header llama-server's --api-key-file checks. ANTHROPIC_API_KEY
# would send X-Api-Key instead and prompt once before overriding a subscription
# login, so the token variable is the one that matches this server.
#
# The header above asks for a shell that already holds the bearer; the
# parameter expansion below honors that rather than undoing it, so sourcing
# this file after `export ANTHROPIC_AUTH_TOKEN=...` in the calling shell
# leaves the real credential in place instead of overwriting it with the
# placeholder.
: "${ANTHROPIC_AUTH_TOKEN:=REPLACE_WITH_APPLIANCE_BEARER}"
export ANTHROPIC_AUTH_TOKEN

# The registry id GET /v1/models returns. The router resolves the child from the
# request body's top-level "model", so this string is the routing key.
export ANTHROPIC_MODEL=qwen38-4b-distill

# The alias models. Claude Code resolves haiku for background work, so leaving
# it on the appliance keeps every request on one origin; the 2B distill is the
# roster's fast text lane.
export ANTHROPIC_DEFAULT_HAIKU_MODEL=qwen38-2b-distill
export ANTHROPIC_DEFAULT_SONNET_MODEL=qwen38-4b-distill
export ANTHROPIC_DEFAULT_OPUS_MODEL=qwen38-4b-distill

# The 4B distill decodes at about 3 tok/s, so a reply that would take one minute
# against a hosted model takes several here. The default is 600000 ms.
export API_TIMEOUT_MS=1800000

# MAX_THINKING_TOKENS bounds the "thinking" block Claude Code puts in its own
# request. server_chat_convert_anthropic_to_oai passes chat_template_kwargs
# through unchanged and never derives it from that block, so a Claude Code
# turn still runs the model template's own default for <think> regardless of
# this setting -- docs/code-agents.md's "The routes an agent reaches" section
# has the mechanism. Setting it to 0 costs nothing and may still leave
# reasoning on; it does not reach chat_template_kwargs.enable_thinking, which
# is the only switch this appliance reads.
export MAX_THINKING_TOKENS=0

# Keep the session's traffic on the appliance: this suppresses the auto-update
# check, the fast-mode availability check, and gateway model discovery.
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export DISABLE_TELEMETRY=1
