+/**
+ * The tools endpoint scoped to the model whose tools these are.
+ *
+ * A router serves one tool set per model and refuses a request that names none
+ * with `model name is missing from the request`, so a page that asked globally
+ * received 400 and listed no tools at all. The selection the page already holds
+ * is what scopes the request, and a page holding none sends the bare endpoint,
+ * which is what a single-model server answers.
+ */
+function toolsEndpoint(endpoint: string): string {
+	const model = modelsStore.selectedModelName ?? modelsStore.models[0]?.model ?? '';
+
+	return model ? `${endpoint}?model=${encodeURIComponent(model)}` : endpoint;
+}
