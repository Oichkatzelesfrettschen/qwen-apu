+    # The int24 arm computes the packed 4x8 dot product from masked bytes and a
+    # 24-bit multiply, so the q8_1 mat-vec shaders and the pipeline table that
+    # names them reach a device whose driver reports no dot-product
+    # acceleration and a glslc that rejects GL_EXT_integer_dot_product. The
+    # definition rides the same forwarding the extension probes use, because a
+    # definition landing on the backend alone builds a pipeline table naming
+    # shaders the generator never wrote.
+    if (GGML_VULKAN_INT24_DOT)
+        message(STATUS "Enabling the int24 packed dot product")
+        add_compile_definitions(GGML_VULKAN_INT24_DOT)
+        list(APPEND VULKAN_SHADER_GEN_CMAKE_ARGS -DGGML_VULKAN_INT24_DOT=ON)
+    endif()
+
     target_link_libraries(ggml-vulkan PRIVATE Vulkan::Vulkan)
     target_include_directories(ggml-vulkan PRIVATE ${CMAKE_CURRENT_BINARY_DIR})
 
