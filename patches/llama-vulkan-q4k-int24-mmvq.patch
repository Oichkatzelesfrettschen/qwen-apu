+    const uint a0 =  au        & 0xFFu;
+    const uint a1 = (au >>  8) & 0xFFu;
+    const uint a2 = (au >> 16) & 0xFFu;
+    const uint a3 = (au >> 24) & 0xFFu;
+
+    const uint b0 =  bu        & 0xFFu;
+    const uint b1 = (bu >>  8) & 0xFFu;
+    const uint b2 = (bu >> 16) & 0xFFu;
+    const uint b3 = (bu >> 24) & 0xFFu;
