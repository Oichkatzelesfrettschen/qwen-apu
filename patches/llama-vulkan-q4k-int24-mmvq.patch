+        ( quants_x        & 0xFFu) * ( biased_x        & 0xFFu) +
+        ((quants_x >>  8) & 0xFFu) * ((biased_x >>  8) & 0xFFu) +
+        ((quants_x >> 16) & 0xFFu) * ((biased_x >> 16) & 0xFFu) +
+        ((quants_x >> 24) & 0xFFu) * ((biased_x >> 24) & 0xFFu) +
+        ( quants_y        & 0xFFu) * ( biased_y        & 0xFFu) +
+        ((quants_y >>  8) & 0xFFu) * ((biased_y >>  8) & 0xFFu) +
+        ((quants_y >> 16) & 0xFFu) * ((biased_y >> 16) & 0xFFu) +
+        ((quants_y >> 24) & 0xFFu) * ((biased_y >> 24) & 0xFFu) +
+        ( quants_z        & 0xFFu) * ( biased_z        & 0xFFu) +
+        ((quants_z >>  8) & 0xFFu) * ((biased_z >>  8) & 0xFFu) +
+        ((quants_z >> 16) & 0xFFu) * ((biased_z >> 16) & 0xFFu) +
+        ((quants_z >> 24) & 0xFFu) * ((biased_z >> 24) & 0xFFu) +
+        ( quants_w        & 0xFFu) * ( biased_w        & 0xFFu) +
+        ((quants_w >>  8) & 0xFFu) * ((biased_w >>  8) & 0xFFu) +
+        ((quants_w >> 16) & 0xFFu) * ((biased_w >> 16) & 0xFFu) +
+        ((quants_w >> 24) & 0xFFu) * ((biased_w >> 24) & 0xFFu);
+
+    const uint sum_n =
+        ( quants_x        & 0xFFu) + ((quants_x >>  8) & 0xFFu) +
+        ((quants_x >> 16) & 0xFFu) + ((quants_x >> 24) & 0xFFu) +
+        ( quants_y        & 0xFFu) + ((quants_y >>  8) & 0xFFu) +
+        ((quants_y >> 16) & 0xFFu) + ((quants_y >> 24) & 0xFFu) +
+        ( quants_z        & 0xFFu) + ((quants_z >>  8) & 0xFFu) +
+        ((quants_z >> 16) & 0xFFu) + ((quants_z >> 24) & 0xFFu) +
+        ( quants_w        & 0xFFu) + ((quants_w >>  8) & 0xFFu) +
+        ((quants_w >> 16) & 0xFFu) + ((quants_w >> 24) & 0xFFu);
+
+    q_sum = int32_t(sum_nb) - int32_t(sum_n << 7);
+#else
     q_sum += dotPacked4x8EXT(qs_a.x, cache_b_qs[0]);
     q_sum += dotPacked4x8EXT(qs_a.y, cache_b_qs[1]);
     q_sum += dotPacked4x8EXT(qs_a.z, cache_b_qs[2]);
     q_sum += dotPacked4x8EXT(qs_a.w, cache_b_qs[3]);
+#endif
 
     return FLOAT_TYPE(float(cache_b_ds.x) * float(dm_scale.x) * float(q_sum) - float(dm_scale.y) * float(cache_b_ds.y / 2));
 }
