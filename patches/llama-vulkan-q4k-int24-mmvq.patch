+// which a byte masked out of a 32-bit word satisfies and a sign-extended int8
+// does not, its unsigned bound being 0xffffffff. Each operand is therefore
+// biased into 0..255 and the bias is removed once per call, from
+// sum((au - 128) * (bu - 128)) = sum(au*bu) - 128*(sum au + sum bu) + 4*128*128.
+// Every intermediate stays unsigned and below 2^19, so each conversion back to
+// int is of a value the signed type represents.
+int32_t dot_packed_4x8_int24(const int32_t packed_a, const int32_t packed_b) {
+    const uint au = uint(packed_a) ^ 0x80808080u;
+    const uint bu = uint(packed_b) ^ 0x80808080u;
