+struct server_prefix_checkpoint {
+    bool armed = false;
+
+    std::string          key;
+    llama_tokens         tokens;
+    std::vector<uint8_t> data;
+
+    size_t n_tokens() const { return tokens.size(); }
+
+    bool empty() const { return data.empty() || tokens.empty(); }
+
+    void clear() {
+        key.clear();
+        tokens.clear();
+        data.clear();
+        data.shrink_to_fit();
+    }
+
+    // The key labels the pin and this comparison guards it: a request restores
+    // the state only where its own tokens reproduce the pinned array element
+    // by element, so a digest collision moves no state.
+    bool covers(const server_tokens & request) const {
+        if (empty() || request.has_mtmd || request.size() <= tokens.size()) {
+            return false;
+        }
+
+        for (size_t i = 0; i < tokens.size(); i++) {
+            if (request[i] != tokens[i]) {
+                return false;
+            }
+        }
+
+        return true;
+    }
+
+    bool capture(
+            llama_context      * ctx,
+            llama_seq_id         seq_id,
+            const llama_tokens & prefix,
+            const std::string  & prefix_key) {
+        const size_t size = llama_state_seq_get_size_ext(ctx, seq_id, LLAMA_STATE_SEQ_FLAGS_NONE);
+
+        std::vector<uint8_t> buffer;
+        try {
+            buffer.resize(size);
+        } catch (const std::bad_alloc & e) {
+            SRV_WRN("prefix checkpoint: allocation of %zu bytes failed: %s\n", size, e.what());
+            return false;
+        }
+
+        if (llama_state_seq_get_data_ext(ctx, buffer.data(), size, seq_id, LLAMA_STATE_SEQ_FLAGS_NONE) != size) {
+            SRV_WRN("prefix checkpoint: state read returned a short count for %zu bytes\n", size);
+            return false;
+        }
+
+        key    = prefix_key;
+        tokens = prefix;
+        data   = std::move(buffer);
+
+        return true;
+    }
+
+    bool restore(llama_context * ctx, llama_seq_id seq_id) const {
+        return llama_state_seq_set_data_ext(ctx, data.data(), data.size(), seq_id, LLAMA_STATE_SEQ_FLAGS_NONE) == data.size();
+    }
+};
