diff --git a/tools/server/server-prefix-checkpoint.h b/tools/server/server-prefix-checkpoint.h
new file mode 100644
index 000000000..10aa856fb
--- /dev/null
+++ b/tools/server/server-prefix-checkpoint.h
@@ -0,0 +1,231 @@
+#pragma once
+
+// Key derivation for the schema-bound prefix checkpoint.
+//
+// The server retains one full sequence state captured at the boundary of the
+// last user message and restores it for any later request whose token array
+// starts with the same prefix, whatever conversation that request belongs to.
+// A state is only the state a prefix would produce while the model, the chat
+// template, the runtime tuple that decides the state layout, and the prefix
+// tokens themselves all hold, so the key is a digest over exactly those
+// fields and a change in any one of them retires the pin.
+//
+// The digest labels the pin and the verbatim token comparison guards it:
+// prefix_checkpoint_key names what the retained state claims to be, and the
+// restore path still compares the pinned token array element by element
+// against the request before it loads anything, so a digest collision moves no
+// state.
+//
+// The chat template renders tool schemas into the system message, so the
+// server observes one system span rather than a system prompt and a tool set
+// it could digest apart. system_span_digest therefore carries the tool
+// schemas, and a caller that needs them separated supplies its own field.
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+struct prefix_checkpoint_sha256 {
+    uint32_t state[8];
+    uint64_t n_bits;
+    uint8_t  block[64];
+    size_t   n_block;
+
+    prefix_checkpoint_sha256() { reset(); }
+
+    void reset() {
+        state[0] = 0x6a09e667u; state[1] = 0xbb67ae85u;
+        state[2] = 0x3c6ef372u; state[3] = 0xa54ff53au;
+        state[4] = 0x510e527fu; state[5] = 0x9b05688cu;
+        state[6] = 0x1f83d9abu; state[7] = 0x5be0cd19u;
+        n_bits  = 0;
+        n_block = 0;
+    }
+
+    static uint32_t rotr(uint32_t x, uint32_t n) { return (x >> n) | (x << (32 - n)); }
+
+    void compress(const uint8_t * p) {
+        static const uint32_t k[64] = {
+            0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u,
+            0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
+            0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u,
+            0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
+            0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu,
+            0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
+            0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u,
+            0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
+            0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u,
+            0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
+            0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u,
+            0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
+            0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u,
+            0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
+            0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u,
+            0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u,
+        };
+
+        uint32_t w[64];
+        for (int i = 0; i < 16; i++) {
+            w[i] = ((uint32_t) p[4*i + 0] << 24) | ((uint32_t) p[4*i + 1] << 16) |
+                   ((uint32_t) p[4*i + 2] <<  8) | ((uint32_t) p[4*i + 3]);
+        }
+        for (int i = 16; i < 64; i++) {
+            const uint32_t s0 = rotr(w[i - 15],  7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>  3);
+            const uint32_t s1 = rotr(w[i -  2], 17) ^ rotr(w[i -  2], 19) ^ (w[i -  2] >> 10);
+            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+        }
+
+        uint32_t a = state[0], b = state[1], c = state[2], d = state[3];
+        uint32_t e = state[4], f = state[5], g = state[6], h = state[7];
+
+        for (int i = 0; i < 64; i++) {
+            const uint32_t s1    = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
+            const uint32_t ch    = (e & f) ^ ((~e) & g);
+            const uint32_t temp1 = h + s1 + ch + k[i] + w[i];
+            const uint32_t s0    = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
+            const uint32_t maj   = (a & b) ^ (a & c) ^ (b & c);
+            const uint32_t temp2 = s0 + maj;
+
+            h = g; g = f; f = e; e = d + temp1;
+            d = c; c = b; b = a; a = temp1 + temp2;
+        }
+
+        state[0] += a; state[1] += b; state[2] += c; state[3] += d;
+        state[4] += e; state[5] += f; state[6] += g; state[7] += h;
+    }
+
+    void update(const void * data, size_t n) {
+        const uint8_t * p = (const uint8_t *) data;
+
+        n_bits += (uint64_t) n * 8;
+
+        while (n > 0) {
+            const size_t take = (64 - n_block) < n ? (64 - n_block) : n;
+            memcpy(block + n_block, p, take);
+            n_block += take;
+            p       += take;
+            n       -= take;
+
+            if (n_block == 64) {
+                compress(block);
+                n_block = 0;
+            }
+        }
+    }
+
+    void update(const std::string & s) { update(s.data(), s.size()); }
+
+    std::string hex() {
+        uint8_t pad[72];
+        size_t  n_pad = 0;
+
+        pad[n_pad++] = 0x80;
+        while ((n_block + n_pad) % 64 != 56) {
+            pad[n_pad++] = 0x00;
+        }
+
+        const uint64_t bits = n_bits;
+        for (int i = 7; i >= 0; i--) {
+            pad[n_pad++] = (uint8_t) ((bits >> (8*i)) & 0xff);
+        }
+        update(pad, n_pad);
+
+        char out[65];
+        for (int i = 0; i < 8; i++) {
+            snprintf(out + 8*i, 9, "%08x", state[i]);
+        }
+
+        return std::string(out, 64);
+    }
+};
+
+inline std::string prefix_checkpoint_digest(const void * data, size_t n) {
+    prefix_checkpoint_sha256 h;
+    h.update(data, n);
+    return h.hex();
+}
+
+inline std::string prefix_checkpoint_digest(const std::string & s) {
+    return prefix_checkpoint_digest(s.data(), s.size());
+}
+
+// A token array digests as its little-endian 32-bit elements, so the digest is
+// the same on every host that agrees on the tokenizer rather than on the
+// compiler's own vector padding.
+inline std::string prefix_checkpoint_token_digest(const int32_t * tokens, size_t n_tokens) {
+    prefix_checkpoint_sha256 h;
+
+    for (size_t i = 0; i < n_tokens; i++) {
+        const uint32_t v = (uint32_t) tokens[i];
+        const uint8_t  b[4] = {
+            (uint8_t) ( v        & 0xff),
+            (uint8_t) ((v >>  8) & 0xff),
+            (uint8_t) ((v >> 16) & 0xff),
+            (uint8_t) ((v >> 24) & 0xff),
+        };
+        h.update(b, 4);
+    }
+
+    return h.hex();
+}
+
+// Every field a retained prefix state depends on, in one place, so a reader
+// checks the key against the list rather than against the call site.
+struct prefix_checkpoint_key_fields {
+    // model file path and the loader's own description of what it holds
+    std::string model_identity;
+
+    // the chat template text the server resolved for this model
+    std::string chat_template;
+
+    // n_ctx, n_batch, n_ubatch, cache type K, cache type V, flash attention,
+    // and the context checkpoint count: the tuple that decides the layout of
+    // the bytes llama_state_seq_get_data_ext writes
+    std::string runtime_tuple;
+
+    // the build the state was produced by, since a state blob is a private
+    // encoding rather than a stable format
+    std::string build_identity;
+
+    // digest of the tokens of the system span, which carries the tool schemas
+    std::string system_span_digest;
+
+    // digest of the whole retained prefix token array
+    std::string prefix_token_digest;
+
+    // length of that array, stated beside its digest so a truncation is a
+    // different key rather than a different reading of the same one
+    size_t n_prefix_tokens = 0;
+};
+
+// The key is a digest over length-prefixed fields, so a byte moved from one
+// field into the next changes the key rather than leaving it alone.
+inline std::string prefix_checkpoint_key(const prefix_checkpoint_key_fields & fields) {
+    prefix_checkpoint_sha256 h;
+
+    const auto add = [&h](const char * name, const std::string & value) {
+        char header[64];
+        const int n = snprintf(header, sizeof(header), "%s:%zu:", name, value.size());
+        h.update(header, (size_t) (n > 0 ? n : 0));
+        h.update(value);
+        h.update("\n", 1);
+    };
+
+    h.update("qwen-prefix-checkpoint-v1\n");
+
+    add("model",    fields.model_identity);
+    add("template", fields.chat_template);
+    add("runtime",  fields.runtime_tuple);
+    add("build",    fields.build_identity);
+    add("system",   fields.system_span_digest);
+    add("prefix",   fields.prefix_token_digest);
+
+    char count[64];
+    const int n = snprintf(count, sizeof(count), "n_prefix_tokens:%zu\n", fields.n_prefix_tokens);
+    h.update(count, (size_t) (n > 0 ? n : 0));
+
+    return h.hex();
+}
