diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_q4_k_prepass.comp b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_q4_k_prepass.comp
new file mode 100644
index 000000000..9fa5cba1d
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_q4_k_prepass.comp
@@ -0,0 +1,73 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : enable
+
+// The activation group-sum sideplane for the Q4_K dequantize-then-dot mat-vec.
+//
+// mul_mat_vec_q4_k.comp forms four activation partial sums per lane per 256-element
+// superblock, and every output-row workgroup consuming that activation column forms
+// them again. This pre-pass writes them once, in exactly the lane-chunk layout
+// mul_mat_vec_q4_k.comp's by_group_sum uses, so the consumer's addition order is
+// unchanged and the accumulated value stays bit-for-bit what the in-shader hoist
+// produced.
+//
+// The layout follows from the consumer's own indexing. The 16 lanes that tile one
+// superblock each read the four-element chunks at y1_idx, y1_idx + 32, y2_idx, and
+// y2_idx + 32, where y_offset = 64*v_im + 4*(2*ir + v_in) is a function of the lane
+// alone, so the sideplane holds 64 sums per superblock and token column. The chunk
+// index is the consumer's SIDEPLANE_CHUNK(y_offset) = 8*v_im + 2*ir + v_in, and this
+// shader walks it directly and inverts it into y_offset, which makes the two
+// expressions one relation rather than two permutations that have to agree.
+// The result is a quarter-scale image of the activation region: a token column of K
+// f32 elements produces K/4 f32 sums, K bytes against the column's 4K.
+
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+
+layout (binding = 0) readonly buffer BV4 {vec4 data_b_v4[];};
+layout (binding = 1) writeonly buffer S {vec4 data_s_v4[];};
+
+layout (push_constant) uniform parameter
+{
+    uint num_blocks_per_row;  // K / 256
+    uint num_columns;         // token columns covered by this dispatch
+    uint batch_stride_b;      // activation elements between columns, equal to K
+} p;
+
+#define QUANT_K 256
+
+void main() {
+    const uint idx = gl_GlobalInvocationID.x;
+    const uint entries_per_column = p.num_blocks_per_row * 16;
+
+    if (idx >= entries_per_column * p.num_columns) {
+        return;
+    }
+
+    const uint column = idx / entries_per_column;
+    const uint rem = idx - column * entries_per_column;
+    const uint i = rem / 16;
+    const uint chunk = rem - i * 16;
+
+    // The inverse of the consumer's SIDEPLANE_CHUNK: v_im is the high bit triple and
+    // 2*ir + v_in is the low three bits, which is exactly l0 / 4.
+    const uint y_offset = 64 * (chunk / 8) + 4 * (chunk % 8);
+
+    const uint column_base = column * p.batch_stride_b;
+    const uint y1_idx = i * QUANT_K + y_offset;
+    const uint y2_idx = y1_idx + 128;
+
+    const vec4 by10 =  data_b_v4[(column_base + y1_idx) / 4    ];
+    const vec4 by132 = data_b_v4[(column_base + y1_idx) / 4 + 8];
+    const vec4 by20 =  data_b_v4[(column_base + y2_idx) / 4    ];
+    const vec4 by232 = data_b_v4[(column_base + y2_idx) / 4 + 8];
+
+    // The same four left-associated chains mul_mat_vec_q4_k.comp forms, so the stored
+    // f32 equals the value the consumer would have built in registers.
+    vec4 sums;
+    sums.x = float(by10.x)  + float(by10.y)  + float(by10.z)  + float(by10.w);
+    sums.y = float(by132.x) + float(by132.y) + float(by132.z) + float(by132.w);
+    sums.z = float(by20.x)  + float(by20.y)  + float(by20.z)  + float(by20.w);
+    sums.w = float(by232.x) + float(by232.y) + float(by232.z) + float(by232.w);
+
+    data_s_v4[column_base / 16 + i * 16 + chunk] = sums;
+}
