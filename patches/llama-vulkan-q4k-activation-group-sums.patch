+        const vec4 by132 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y1_idx) / 4 + 8]);
+        const vec4 by20 =  vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y2_idx) / 4    ]);
+        const vec4 by232 = vec4(data_b_v4[(j*p.batch_stride_b + b_offset + y2_idx) / 4 + 8]);
+
+        by_group_sum[j][0] = FLOAT_TYPE(by10.x)  + FLOAT_TYPE(by10.y)  + FLOAT_TYPE(by10.z)  + FLOAT_TYPE(by10.w);
+        by_group_sum[j][1] = FLOAT_TYPE(by132.x) + FLOAT_TYPE(by132.y) + FLOAT_TYPE(by132.z) + FLOAT_TYPE(by132.w);
