+const SIZE_TAG = /^(\d+(?:\.\d+)?)B$/;
+
+/**
+ * The measured parameter count in billions a model's tags state, or null.
+ *
+ * remote/model-capabilities.tsv fills this tag from the sum of every tensor's
+ * shape rather than from a publisher's label, because the two disagree: one
+ * checkpoint advertised at 1.6B measures 1.17B and would otherwise sort among
+ * checkpoints half again its size.
+ */
+function taggedParameters(option: ModelOption): number | null {
+	for (const tag of option.tags ?? []) {
+		const match = SIZE_TAG.exec(tag);
+
+		if (match) return Number(match[1]);
+	}
+
+	return null;
+}
+
+/**
+ * Every option ordered by parameter count and then by name within it, so two
+ * checkpoints of one size sit together and a reader scans the list by the cost
+ * of running a model. An option whose size is unstated sorts after the sized
+ * ones rather than at an arbitrary position.
+ */
+export function sortModelOptions(options: ModelOption[]): ModelOption[] {
+	return [...options].sort((left, right) => {
+		const leftSize = taggedParameters(left);
+		const rightSize = taggedParameters(right);
+
+		if (leftSize !== rightSize) {
+			if (leftSize === null) return 1;
+			if (rightSize === null) return -1;
+
+			return leftSize - rightSize;
+		}
+
+		return (left.name ?? left.model).localeCompare(right.name ?? right.model);
+	});
+}
