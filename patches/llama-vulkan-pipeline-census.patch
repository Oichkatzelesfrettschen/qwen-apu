+    uint32_t capacity {};
+    uint32_t max_dispatches {};
+    uint32_t query_idx {};
+    bool armed {};
+    bool overflow {};
+    bool pending {};
+    bool reach_written {};
+    uint32_t reach_query {};
+    uint64_t graph_serial {};
+    uint64_t queue_submit_serial {};
+    uint64_t pending_submits {};
+    uint32_t queue_family {};
+    uint32_t next_pipeline_id {1};
