+// One dispatch the census recorded. Two query slots bracket it: `reach_query`
+// holds a top-of-pipe timestamp written immediately before vkCmdDispatch,
+// which the command processor writes when it reaches the dispatch, and
+// `complete_query` holds an all-commands timestamp written immediately
+// after it, which the device writes when the dispatch and everything ahead
+// of it have completed. The bracket bounds the dispatch's residency on the
+// queue; it is an upper bound on the kernel's own duration where the queue
+// lets neighbours overlap and equals it where a barrier separates them. The
+// record is fixed-size, and the vector that holds it is reserved to the
+// pool's dispatch capacity ahead of arming, so recording allocates nothing.
+// `submit_serial` is 0 until ggml_vk_submit binds the serial it allocates
+// for the command buffer the record names.
+struct vk_census_dispatch {
+    uint32_t reach_query;
+    uint32_t complete_query;
+    vk_pipeline_struct * pipeline;
+    const vk_command_buffer * cmd_buffer;
+    uint64_t cmd_buffer_use;
