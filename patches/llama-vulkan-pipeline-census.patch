+// Binds the serial this submit allocates to every recorded dispatch whose
+// command buffer it carries. The serial is per census, so per compute queue
+// of the owning context, and is assigned here rather than predicted.
+static void ggml_vk_census_bind_submit(vk_pipeline_census * census, const vk_context & ctx) {
