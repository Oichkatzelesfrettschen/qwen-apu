+// Reads the query pool of the pending graph and writes its rows. `read_at`
+// names the synchronization point; `wait` is true only on the two fallback
+// reads whose pool is about to be reset, and the row carries it.
+static void ggml_vk_census_read_pending(ggml_backend_vk_context * ctx, const char * read_at, bool wait) {
+    vk_pipeline_census & census = ctx->census;
+    if (!census.enabled || !census.pending) {
+        return;
+    }
+    census.pending = false;
+    const uint64_t retire_monotonic_ns = ggml_vk_census_monotonic_ns();
+    const uint64_t retire_span_ns = (uint64_t) std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now() - census.graph_begin).count();
+
+    // Each query returns its value and an availability word; a value the
+    // device has not written is counted rather than assumed.
+    std::vector<uint64_t> & results = census.readback;
+    results.assign((size_t) census.query_idx * 2, 0);
+    if (census.query_idx > 0) {
+        vk::QueryResultFlags flags = vk::QueryResultFlagBits::e64 | vk::QueryResultFlagBits::eWithAvailability;
+        if (wait) {
+            flags |= vk::QueryResultFlagBits::eWait;
+        }
+        vk::Result result = ctx->device->device.getQueryPoolResults(census.pool, 0, census.query_idx,
+                    results.size() * sizeof(uint64_t), results.data(), 2 * sizeof(uint64_t), flags);
+        if (result != vk::Result::eSuccess && result != vk::Result::eNotReady) {
+            throw std::runtime_error("census getQueryPoolResults: " + vk::to_string(result));
+        }
+    }
