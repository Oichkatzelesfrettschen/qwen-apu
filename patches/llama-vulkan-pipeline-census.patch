+static uint64_t ggml_vk_census_monotonic_ns() {
+    return (uint64_t) std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+static void ggml_vk_census_init(ggml_backend_vk_context * ctx) {
+    const char * census_path = getenv("GGML_VK_PIPELINE_CENSUS");
+    if (census_path == nullptr) {
+        return;
+    }
+    // The value names the output file, and a bare flag is refused: a census
+    // that wrote to stderr would interleave with the server log and a run
+    // could then claim rows it never retained.
+    if (census_path[0] != '/') {
+        throw std::runtime_error("GGML_VK_PIPELINE_CENSUS names an absolute output path");
+    }
+    FILE * out = fopen(census_path, "a");
+    if (out == nullptr) {
+        throw std::runtime_error(std::string("GGML_VK_PIPELINE_CENSUS output is unwritable: ") + census_path);
+    }
+    ctx->census.enabled = true;
+    ctx->census.path = census_path;
+    ctx->census.out = out;
+    ctx->compute_cmd_pool.census = &ctx->census;
+    {
+        const auto queue_families = ctx->device->physical_device.getQueueFamilyProperties();
+        const uint32_t family = ctx->device->compute_queue->queue_family_index;
+        uint32_t valid_bits = 64;
+        if (family < queue_families.size()) {
+            valid_bits = queue_families[family].timestampValidBits;
+        }
+        if (valid_bits == 0) {
+            throw std::runtime_error("GGML_VK_PIPELINE_CENSUS: the compute queue family reports no timestamp support");
+        }
+        ctx->census.timestamp_mask = valid_bits >= 64 ? UINT64_MAX : ((1ULL << valid_bits) - 1ULL);
+        ctx->census.queue_family = family;
+        fprintf(out, "census_queue\tfamily=%u\ttimestamp_valid_bits=%u\n", family, valid_bits);
+    }
+    fprintf(out, "census_open\tformat=pipeline-census-v2\tdevice=%s\ttimestamp_period_ns=%.6f\tserialize_submissions=%d\tmax_nodes_per_submit=%u\tclock=CLOCK_MONOTONIC\n",
+            ctx->device->name.c_str(), (double) ctx->device->properties.limits.timestampPeriod,
+            ctx->device->serialize_submissions ? 1 : 0, (unsigned) ctx->device->max_nodes_per_submit);
+    fflush(out);
+}
