+static void ggml_vk_census_begin_graph(ggml_backend_vk_context * ctx, ggml_cgraph * cgraph) {
+    vk_pipeline_census & census = ctx->census;
+    if (!census.enabled) {
+        return;
+    }
+    // A previous graph whose pool was never read at a synchronization point
+    // is read here with a wait, since its pool is reset below; the row names
+    // the read point and the summarizer refuses the graph.
+    ggml_vk_census_read_pending(ctx, "next_graph", true);
+    // One origin timestamp plus a bracket per dispatch; a node issues up to
+    // a handful of dispatches, so the pool grows with the graph and the
+    // record store is reserved to the pool's dispatch capacity here, off the
+    // dispatch path.
+    const uint32_t required = (uint32_t) cgraph->n_nodes * 8 + 64;
+    if (census.capacity < required) {
+        if (census.pool) {
+            ctx->device->device.destroyQueryPool(census.pool);
+        }
+        vk::QueryPoolCreateInfo create_info;
+        create_info.queryType = vk::QueryType::eTimestamp;
+        create_info.queryCount = required;
+        census.pool = ctx->device->device.createQueryPool(create_info);
+        census.capacity = required;
+        census.max_dispatches = (required - 1) / 2;
+        census.dispatches.reserve(census.max_dispatches);
+        census.readback.reserve((size_t) required * 2);
+    }
+    ctx->device->device.resetQueryPool(census.pool, 0, census.capacity);
+    census.graph_serial++;
+    census.query_idx = 0;
+    census.overflow = false;
+    census.reach_written = false;
+    census.pending_submits = 0;
+    census.dispatches.clear();
+    census.current_node = nullptr;
+    census.current_node_idx = -1;
+    census.current_fused = 0;
+    census.graph_begin = std::chrono::steady_clock::now();
+    vk_context compute_ctx = ggml_vk_get_compute_ctx(ctx);
+    compute_ctx->s->buffer->buf.writeTimestamp(vk::PipelineStageFlagBits::eTopOfPipe, census.pool, census.query_idx++);
+    census.armed = true;
+}
+
+static void ggml_vk_census_end_graph(ggml_backend_vk_context * ctx, ggml_cgraph * cgraph) {
+    vk_pipeline_census & census = ctx->census;
+    if (!census.enabled || !census.armed) {
+        return;
+    }
+    census.armed = false;
+    census.pending = true;
+    census.pending_n_nodes = cgraph->n_nodes;
+    census.pending_record_ns = (uint64_t) std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now() - census.graph_begin).count();
+    // The serialized path waited on the fence inside the last submit, so the
+    // pool has retired and the rows are written at graph end.
+    if (ctx->device->serialize_submissions) {
+        ggml_vk_census_read_pending(ctx, "graph_end", false);
+    }
+}
+
+// Writes the reach timestamp ahead of vkCmdDispatch. Returns whether the
+// dispatch will be recorded; a pool without room for the bracket marks the
+// graph overflowed and records nothing further.
+static bool ggml_vk_census_dispatch_reach(ggml_backend_vk_context * ctx, vk_context & subctx) {
+    vk_pipeline_census & census = ctx->census;
+    if (!census.enabled || !census.armed) {
+        return false;
+    }
+    if (census.query_idx + 2 > census.capacity || census.dispatches.size() >= census.max_dispatches) {
+        census.overflow = true;
+        return false;
+    }
+    census.reach_query = census.query_idx++;
+    census.reach_written = true;
+    subctx->s->buffer->buf.writeTimestamp(vk::PipelineStageFlagBits::eTopOfPipe, census.pool, census.reach_query);
+    return true;
+}
