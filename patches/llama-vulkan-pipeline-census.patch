+static void ggml_vk_census_begin_graph(ggml_backend_vk_context * ctx, ggml_cgraph * cgraph) {
+    vk_pipeline_census & census = ctx->census;
+    if (!census.enabled) {
+        return;
+    }
+    // A previous graph whose pool was never read at a synchronization point
+    // is read here; the wait this may add is named by the row's read_at.
+    ggml_vk_census_read_pending(ctx, "next_graph");
+    const uint32_t required = (uint32_t) cgraph->n_nodes * 4 + 64;
+    if (census.capacity < required) {
+        if (census.pool) {
+            ctx->device->device.destroyQueryPool(census.pool);
+        }
+        vk::QueryPoolCreateInfo create_info;
+        create_info.queryType = vk::QueryType::eTimestamp;
+        create_info.queryCount = required;
+        census.pool = ctx->device->device.createQueryPool(create_info);
+        census.capacity = required;
+    }
+    ctx->device->device.resetQueryPool(census.pool, 0, census.capacity);
+    census.graph_serial++;
+    census.query_idx = 0;
+    census.overflow = false;
+    census.dispatches.clear();
+    census.current_node = nullptr;
+    census.current_node_idx = -1;
+    census.current_fused = 0;
+    census.graph_begin = std::chrono::steady_clock::now();
+    vk_context compute_ctx = ggml_vk_get_compute_ctx(ctx);
+    compute_ctx->s->buffer->buf.writeTimestamp(vk::PipelineStageFlagBits::eAllCommands, census.pool, census.query_idx++);
+    census.armed = true;
+}
+
+static void ggml_vk_census_end_graph(ggml_backend_vk_context * ctx, ggml_cgraph * cgraph) {
+    vk_pipeline_census & census = ctx->census;
+    if (!census.enabled || !census.armed) {
+        return;
+    }
+    census.armed = false;
+    census.pending = true;
+    census.pending_n_nodes = cgraph->n_nodes;
+    census.pending_record_ns = (uint64_t) std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now() - census.graph_begin).count();
+    // The serialized path waited on the fence inside the last submit, so the
+    // pool has retired and the rows are written at graph end.
+    if (ctx->device->serialize_submissions) {
+        ggml_vk_census_read_pending(ctx, "graph_end");
+    }
+}
