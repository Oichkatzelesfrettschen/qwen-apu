+// The census keeps one timestamp query pool per backend context, writes one
+// timestamp at graph start and one after every dispatch inside the command
+// buffers the graph already records, and reads the pool where the graph's
+// own fence has retired: in ggml_vk_synchronize after ggml_vk_wait_for_fence
+// on the asynchronous path, at graph end on the serialized path, and at the
+// next graph start as the fallback that names itself. No barrier and no host
+// wait are added, so the intervals are completion-to-completion under the
+// serving profile's own overlap and the summary carries the per-graph union
+// beside the sum. Two host durations are kept apart: record_ns is the time
+// ggml_backend_vk_graph_compute spent recording and submitting, and
+// span_ns runs from graph start to the read, which on the asynchronous path
+// is the synchronize the caller waits in for the logits, so span_ns bounds
+// the token where record_ns bounds only the host's part of it.
+// GGML_VK_PIPELINE_CENSUS names the output file.
+struct vk_pipeline_census {
+    bool enabled {};
+    std::string path;
+    FILE * out {};
+    vk::QueryPool pool;
+    uint32_t capacity {};
+    uint32_t query_idx {};
+    bool armed {};
+    bool overflow {};
+    bool pending {};
+    uint64_t graph_serial {};
+    uint64_t submit_serial {};
+    uint32_t next_pipeline_id {1};
+    int pending_n_nodes {};
+    uint64_t pending_record_ns {};
+    std::chrono::steady_clock::time_point graph_begin;
+    const ggml_tensor * current_node {};
+    int current_node_idx {-1};
+    int current_fused {};
+    std::vector<vk_census_dispatch> dispatches;
+    // Timestamps are valid to the compute queue family's timestampValidBits
+    // and wrap there, so every difference is taken modulo that width.
