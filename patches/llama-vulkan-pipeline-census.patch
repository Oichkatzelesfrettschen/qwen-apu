+static vk_context ggml_vk_get_compute_ctx(ggml_backend_vk_context * ctx);
+static std::atomic<uint64_t> vk_census_submit_serial {0};
+static void vk_census_submit_serial_advance() {
+    vk_census_submit_serial.fetch_add(1);
+}
+
+static void ggml_vk_census_init(ggml_backend_vk_context * ctx) {
+    const char * census_path = getenv("GGML_VK_PIPELINE_CENSUS");
+    if (census_path == nullptr) {
+        return;
+    }
+    // The value names the output file, and a bare flag is refused: a census
+    // that wrote to stderr would interleave with the server log and a run
+    // could then claim rows it never retained.
+    if (census_path[0] != '/') {
+        throw std::runtime_error("GGML_VK_PIPELINE_CENSUS names an absolute output path");
+    }
+    FILE * out = fopen(census_path, "a");
+    if (out == nullptr) {
+        throw std::runtime_error(std::string("GGML_VK_PIPELINE_CENSUS output is unwritable: ") + census_path);
+    }
+    ctx->census.enabled = true;
+    ctx->census.path = census_path;
+    ctx->census.out = out;
+    {
+        const auto queue_families = ctx->device->physical_device.getQueueFamilyProperties();
+        const uint32_t family = ctx->device->compute_queue->queue_family_index;
+        uint32_t valid_bits = 64;
+        if (family < queue_families.size()) {
+            valid_bits = queue_families[family].timestampValidBits;
+        }
+        if (valid_bits == 0) {
+            throw std::runtime_error("GGML_VK_PIPELINE_CENSUS: the compute queue family reports no timestamp support");
+        }
+        ctx->census.timestamp_mask = valid_bits >= 64 ? UINT64_MAX : ((1ULL << valid_bits) - 1ULL);
+        fprintf(out, "census_queue\tfamily=%u\ttimestamp_valid_bits=%u\n", family, valid_bits);
+    }
+    fprintf(out, "census_open\tformat=pipeline-census-v1\tdevice=%s\ttimestamp_period_ns=%.6f\tserialize_submissions=%d\tmax_nodes_per_submit=%u\n",
+            ctx->device->name.c_str(), (double) ctx->device->properties.limits.timestampPeriod,
+            ctx->device->serialize_submissions ? 1 : 0, (unsigned) ctx->device->max_nodes_per_submit);
+    fflush(out);
+}
+
+static void ggml_vk_census_emit_pipeline(ggml_backend_vk_context * ctx, vk_pipeline_struct * pipeline) {
+    vk_pipeline_census & census = ctx->census;
+    pipeline->census_id = census.next_pipeline_id++;
+    std::string constants;
+    for (size_t i = 0; i < pipeline->census_specialization_constants.size(); i++) {
+        if (i) {
+            constants += ",";
+        }
+        constants += std::to_string(pipeline->census_specialization_constants[i]);
+    }
+    fprintf(census.out, "census_pipeline\t%u\t%s\t%s\t%016" PRIx64 "\t%zu\t%s\t%u,%u,%u\t%u\t%d\t%" PRId64 "\t%" PRId64 "\t%" PRId64 "\t%" PRId64 "\t%" PRId64 "\t%" PRId64 "\t%u\n",
+            pipeline->census_id, pipeline->name.c_str(), pipeline->census_entrypoint.c_str(),
+            pipeline->census_spirv_fnv1a64, pipeline->census_spirv_bytes,
+            constants.empty() ? "-" : constants.c_str(),
+            pipeline->wg_denoms[0], pipeline->wg_denoms[1], pipeline->wg_denoms[2],
+            pipeline->census_required_subgroup_size, pipeline->census_require_full_subgroups ? 1 : 0,
+            pipeline->census_vgprs, pipeline->census_sgprs, pipeline->census_spilled_vgprs,
+            pipeline->census_lds_size, pipeline->census_scratch_size, pipeline->census_subgroups_per_simd,
+            pipeline->register_count);
+}
+
+// Reads the retired query pool and writes the graph's rows. `read_at` names
+// the synchronization point the read happened at.
+static void ggml_vk_census_read_pending(ggml_backend_vk_context * ctx, const char * read_at) {
+    vk_pipeline_census & census = ctx->census;
+    if (!census.enabled || !census.pending) {
+        return;
+    }
+    census.pending = false;
+    std::vector<uint64_t> timestamps(census.query_idx);
+    if (census.query_idx > 0) {
+        VK_CHECK(ctx->device->device.getQueryPoolResults(census.pool, 0, census.query_idx,
+                    census.query_idx * sizeof(uint64_t), timestamps.data(), sizeof(uint64_t),
+                    vk::QueryResultFlagBits::e64 | vk::QueryResultFlagBits::eWait),
+                 "census getQueryPoolResults", ctx->device);
+    }
+    const double period = ctx->device->properties.limits.timestampPeriod;
+    uint64_t sum_ns = 0;
+    for (const vk_census_dispatch & d : census.dispatches) {
+        vk_pipeline_struct * pipeline = d.pipeline;
+        if (pipeline->census_id == 0) {
+            ggml_vk_census_emit_pipeline(ctx, pipeline);
+        }
+        const uint64_t previous = timestamps[d.query - 1];
+        const uint64_t current = timestamps[d.query];
+        const uint64_t gpu_ns = (uint64_t) (((current - previous) & census.timestamp_mask) * period);
+        sum_ns += gpu_ns;
+        fprintf(census.out, "census_dispatch\t%" PRIu64 "\t%u\t%u\t%d\t%d\t%s\t%s\t%s\t%s\t%s\t%s\t%" PRId64 "\t%" PRId64 "\t%" PRId64 "\t%" PRId64 "\t%" PRId64 "\t%u\t%u\t%u\t%" PRIu64 "\t%" PRIu64 "\n",
+                census.graph_serial, d.query, pipeline->census_id, d.node_idx, d.fused,
+                ggml_op_name(d.op), d.dst_name, d.src0_name,
+                ggml_type_name(d.src0_type), d.src1_type == GGML_TYPE_COUNT ? "-" : ggml_type_name(d.src1_type),
+                ggml_type_name(d.dst_type),
+                d.ne[0], d.ne[1], d.ne[2], d.ne[3], d.src1_ne1,
+                d.wg[0], d.wg[1], d.wg[2], gpu_ns, d.submit_serial);
+    }
+    const uint64_t union_ns = census.query_idx > 1
+        ? (uint64_t) (((timestamps[census.query_idx - 1] - timestamps[0]) & census.timestamp_mask) * period) : 0;
+    const uint64_t span_ns = (uint64_t) std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now() - census.graph_begin).count();
+    fprintf(census.out, "census_graph\t%" PRIu64 "\t%d\t%zu\t%" PRIu64 "\t%" PRIu64 "\t%" PRIu64 "\t%" PRIu64 "\t%d\t%s\n",
+            census.graph_serial, census.pending_n_nodes, census.dispatches.size(),
+            census.pending_record_ns, span_ns, sum_ns, union_ns, census.overflow ? 1 : 0, read_at);
+    fflush(census.out);
+    census.dispatches.clear();
+}
