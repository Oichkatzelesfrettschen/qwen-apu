+static void ggml_vk_census_dispatch_complete(ggml_backend_vk_context * ctx, vk_context & subctx, vk_pipeline & pipeline, uint32_t wg0, uint32_t wg1, uint32_t wg2) {
+    vk_pipeline_census & census = ctx->census;
+    if (!census.reach_written) {
+        return;
+    }
+    census.reach_written = false;
+    vk_census_dispatch d {};
+    d.reach_query = census.reach_query;
+    d.complete_query = census.query_idx++;
+    d.pipeline = pipeline.get();
+    d.cmd_buffer = subctx->s->buffer;
+    d.cmd_buffer_use = subctx->s->buffer->use_counter;
+    d.node_idx = census.current_node_idx;
+    d.fused = census.current_fused;
+    d.wg[0] = wg0;
+    d.wg[1] = wg1;
+    d.wg[2] = wg2;
+    d.submit_serial = 0;
+    d.src1_type = GGML_TYPE_COUNT;
+    const ggml_tensor * node = census.current_node;
+    if (node) {
+        d.op = node->op;
+        snprintf(d.dst_name, sizeof(d.dst_name), "%s", node->name);
+        d.dst_type = node->type;
+        for (int i = 0; i < 4; i++) {
+            d.ne[i] = node->ne[i];
+        }
+        if (node->src[0]) {
+            snprintf(d.src0_name, sizeof(d.src0_name), "%s", node->src[0]->name);
+            d.src0_type = node->src[0]->type;
+        } else {
+            snprintf(d.src0_name, sizeof(d.src0_name), "-");
+            d.src0_type = node->type;
+        }
+        if (node->src[1]) {
+            d.src1_type = node->src[1]->type;
+            d.src1_ne1 = node->src[1]->ne[1];
+        }
+    } else {
+        d.op = GGML_OP_NONE;
+        snprintf(d.dst_name, sizeof(d.dst_name), "-");
+        snprintf(d.src0_name, sizeof(d.src0_name), "-");
+        d.dst_type = GGML_TYPE_F32;
+        d.src0_type = GGML_TYPE_F32;
+    }
+    subctx->s->buffer->buf.writeTimestamp(vk::PipelineStageFlagBits::eAllCommands, census.pool, d.complete_query);
+    census.dispatches.push_back(d);
+}
