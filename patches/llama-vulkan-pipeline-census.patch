+// Assigns the census-local pipeline id on first sight and writes the
+// description row. The id belongs to this census file alone.
+static uint32_t ggml_vk_census_pipeline_id(vk_pipeline_census & census, const vk_pipeline_struct * pipeline) {
+    auto found = census.pipeline_ids.find(pipeline);
+    if (found != census.pipeline_ids.end()) {
+        return found->second;
+    }
+    const uint32_t id = census.next_pipeline_id++;
+    census.pipeline_ids.emplace(pipeline, id);
+    std::string constants;
+    for (size_t i = 0; i < pipeline->census_specialization_constants.size(); i++) {
+        if (i) {
+            constants += ",";
+        }
+        constants += std::to_string(pipeline->census_specialization_constants[i]);
+    }
+    fprintf(census.out, "census_pipeline\t%u\t%s\t%s\t%s\t%zu\t%s\t%zu\t%s\t%u,%u,%u\t%u\t%d\t%u\t%u\t%" PRId64 "\t%" PRId64 "\t%" PRId64 "\t%" PRId64 "\t%" PRId64 "\t%" PRId64 "\t%u\n",
+            id, pipeline->name.c_str(), pipeline->census_entrypoint.c_str(),
+            pipeline->census_spirv_source_sha256.c_str(), pipeline->census_spirv_source_bytes,
+            pipeline->census_spirv_executed_sha256.c_str(), pipeline->census_spirv_executed_bytes,
+            constants.empty() ? "-" : constants.c_str(),
+            pipeline->wg_denoms[0], pipeline->wg_denoms[1], pipeline->wg_denoms[2],
+            pipeline->census_required_subgroup_size, pipeline->census_require_full_subgroups ? 1 : 0,
+            pipeline->parameter_count, pipeline->push_constant_size,
+            pipeline->census_vgprs, pipeline->census_sgprs, pipeline->census_spilled_vgprs,
+            pipeline->census_lds_size, pipeline->census_scratch_size, pipeline->census_subgroups_per_simd,
+            pipeline->register_count);
+    return id;
+}
