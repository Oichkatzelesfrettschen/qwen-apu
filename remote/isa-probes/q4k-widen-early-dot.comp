#version 450

#extension GL_EXT_control_flow_attributes : require

// The widening arm of E2b in
// evidence/raven2-vulkan-kernel-census/decode-decomposition.md. It forms the
// same products as q4k-packed-u8-dot.comp in this directory over the same
// buffer layout, workgroup size, dword per lane, and reduction, and differs
// in one dimension: every field is extracted into a 32-bit local by shift and
// mask before it reaches a multiply, so nothing downstream carries an 8-bit
// type. The pair separates two accounts of a dequant-dot's operand cost on
// gfx902 -- a byte selected in place by SDWA or laid out by v_perm_b32, or a
// shift and a mask spent per value -- and a lab.sh receipt reads which one
// ACO produced from v_lshrrev_b32, v_and_b32, sdwa_operand_uses, and
// v_perm_b32 counted side by side across the two.
//
// bitfieldExtract is what widens the signed activation lane, matching
// q4k-integer-dot.comp's own extraction, so the activation path is common to
// three of this directory's four probes and the weight path is what the pair
// varies.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer WeightsPacked {
    uint weights_packed[];
};

layout(binding = 1) readonly buffer ActivationsPacked {
    uint activations_packed[];
};

layout(binding = 2) writeonly buffer Accumulator {
    int accumulator[];
};

shared int partial_sums[64];

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint dword_index = gl_WorkGroupID.x * gl_WorkGroupSize.x + lane;

    const uint weight_dword = weights_packed[dword_index];
    const uint activation_dword = activations_packed[dword_index];

    // Each of the twelve values becomes its own 32-bit local before any
    // multiply reads it.
    uint weight_lo[4];
    uint weight_hi[4];
    int activations[4];
    [[unroll]] for (uint byte_index = 0; byte_index < 4; ++byte_index) {
        const uint shift = byte_index * 8u;
        weight_lo[byte_index] = (weight_dword >> shift) & 0x0Fu;
        weight_hi[byte_index] = (weight_dword >> (shift + 4u)) & 0x0Fu;
        activations[byte_index] = bitfieldExtract(int(activation_dword), int(shift), 8);
    }

    int product = 0;
    [[unroll]] for (uint byte_index = 0; byte_index < 4; ++byte_index) {
        const int activation = activations[byte_index];
        product += int(weight_lo[byte_index]) * activation;
        product += int(weight_hi[byte_index]) * activation;
    }

    partial_sums[lane] = product;
    barrier();
    if (lane == 0) {
        int workgroup_sum = 0;
        [[unroll]] for (uint i = 0; i < 64u; ++i) {
            workgroup_sum += partial_sums[i];
        }
        accumulator[gl_WorkGroupID.x] = workgroup_sum;
    }
}
