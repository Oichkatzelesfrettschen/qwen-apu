#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

// E2b in evidence/raven2-vulkan-kernel-census/decode-decomposition.md: E2
// asks which multiply ACO selects, and E2b asks whether the packed operands
// reach that multiply still packed. gfx902 carries SDWA on VOP1 and VOP2,
// which selects byte 0 to 3 of a 32-bit source at no extra instruction, and
// v_perm_b32, which lays four arbitrary bytes of two sources into one dword;
// both are how a dequant-dot avoids paying an instruction per byte to unpack.
// A compiler that widens each field to 32 bits at extraction spends a shift
// and a mask per value and then multiplies four full dwords, and the
// mechanism counts in a lab.sh receipt separate the two outcomes:
// v_lshrrev_b32 and v_and_b32 rising together with no sdwa_operand_uses is
// early widening, and sdwa_operand_uses or v_perm_b32 carrying the byte
// selection is the packed path.
//
// This file holds the fields in the 8-bit types
// GL_EXT_shader_explicit_arithmetic_types_int8 declares from the dword they
// arrive in, so unpack8 produces one u8vec4 and one i8vec4 and every
// component keeps an 8-bit type until the multiply widens it. Its sibling
// q4k-widen-early-dot.comp performs the same arithmetic over 32-bit locals
// extracted by shift and mask, and every other structural choice -- workgroup
// size, buffer layout, dword per lane, reduction shape -- is held fixed
// across the pair and across q4k-integer-dot.comp and q4k-float-dot.comp in
// this directory.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// One dword holds eight 4-bit weights, the way a Q4_K superblock's qs array
// packs a low and a high nibble per byte over four bytes.
layout(binding = 0) readonly buffer WeightsPacked {
    uint weights_packed[];
};

// One dword holds four signed 8-bit activations, the way the q8_1 layout
// llama.cpp builds only where the driver reports an accelerated dot product
// packs a quantized activation vector.
layout(binding = 1) readonly buffer ActivationsPacked {
    uint activations_packed[];
};

layout(binding = 2) writeonly buffer Accumulator {
    int accumulator[];
};

shared int partial_sums[64];

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint dword_index = gl_WorkGroupID.x * gl_WorkGroupSize.x + lane;

    const uint weight_dword = weights_packed[dword_index];
    const uint activation_dword = activations_packed[dword_index];

    // Both nibble planes and the activation vector stay in 8-bit vector
    // types, so the value handed to each multiply is a byte-typed component
    // rather than a masked dword.
    const u8vec4 weight_lo4 = unpack8(weight_dword & 0x0F0F0F0Fu);
    const u8vec4 weight_hi4 = unpack8((weight_dword >> 4) & 0x0F0F0F0Fu);
    const i8vec4 activations = unpack8(int(activation_dword));

    int product = 0;
    [[unroll]] for (uint byte_index = 0; byte_index < 4; ++byte_index) {
        const int activation = int(activations[byte_index]);
        product += int(weight_lo4[byte_index]) * activation;
        product += int(weight_hi4[byte_index]) * activation;
    }

    partial_sums[lane] = product;
    barrier();
    if (lane == 0) {
        int workgroup_sum = 0;
        [[unroll]] for (uint i = 0; i < 64u; ++i) {
            workgroup_sum += partial_sums[i];
        }
        accumulator[gl_WorkGroupID.x] = workgroup_sum;
    }
}
