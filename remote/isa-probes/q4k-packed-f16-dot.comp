#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// E7a: whether ACO forms the packed half-rate multiply-add gfx902 carries.
// The buffer layout, the nibble extraction, the eight products per lane, and
// the workgroup reduction are q4k-float-dot.comp's, so the pair differs in
// the arithmetic type alone: this file pairs the eight products into four
// f16vec2 fused multiply-adds and accumulates in f16vec2, which is the form
// v_pk_fma_f16 expresses. Reading v_pk_fma_f16 in the receipt says the packed
// instruction is reachable from GLSL on this target; reading v_mac_f32 or a
// pair of scalar f16 operations says ACO widened or scalarized the vector and
// the packed lever is closed at the compiler rather than at the source.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer WeightsPacked {
    uint weights_packed[];
};

layout(binding = 1) readonly buffer ActivationsPacked {
    uint activations_packed[];
};

layout(binding = 2) writeonly buffer Accumulator {
    float accumulator[];
};

shared float partial_sums[64];

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint dword_index = gl_WorkGroupID.x * gl_WorkGroupSize.x + lane;

    const uint weight_dword = weights_packed[dword_index];
    const uint activation_dword = activations_packed[dword_index];

    const uint weight_lo4 = weight_dword & 0x0F0F0F0Fu;
    const uint weight_hi4 = (weight_dword >> 4) & 0x0F0F0F0Fu;

    f16vec2 product = f16vec2(0.0hf, 0.0hf);
    [[unroll]] for (uint byte_index = 0; byte_index < 4; ++byte_index) {
        const float16_t activation =
            float16_t(bitfieldExtract(int(activation_dword), int(byte_index * 8u), 8));
        const float16_t weight_lo = float16_t((weight_lo4 >> (byte_index * 8u)) & 0xFu);
        const float16_t weight_hi = float16_t((weight_hi4 >> (byte_index * 8u)) & 0xFu);
        product = fma(f16vec2(weight_lo, weight_hi), f16vec2(activation, activation), product);
    }

    partial_sums[lane] = float(product.x) + float(product.y);
    barrier();
    if (lane == 0) {
        float workgroup_sum = 0.0;
        [[unroll]] for (uint i = 0; i < 64u; ++i) {
            workgroup_sum = workgroup_sum + partial_sums[i];
        }
        accumulator[gl_WorkGroupID.x] = workgroup_sum;
    }
}
