#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// E7b: whether ACO forms v_mad_mix_f32, the gfx9 multiply-add that reads f16
// operands and accumulates in f32. The buffer layout, the nibble extraction,
// the eight products per lane, and the workgroup reduction are
// q4k-float-dot.comp's, so the pair differs in the operand type alone: both
// factors are float16_t and the accumulator stays float. Reading
// v_mad_mix_f32 in the receipt says the mixed form is reachable from GLSL and
// the mat-vec could hold its weights in half the registers; reading
// v_cvt_f32_f16 followed by v_mac_f32 says ACO widened at the operand and the
// mixed form buys registers through an extra conversion rather than for free.
// Either outcome leaves the issue count unchanged, since v_mad_mix_f32
// performs one product per instruction the way v_mac_f32 does; the packed
// question is q4k-packed-f16-dot.comp's.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer WeightsPacked {
    uint weights_packed[];
};

layout(binding = 1) readonly buffer ActivationsPacked {
    uint activations_packed[];
};

layout(binding = 2) writeonly buffer Accumulator {
    float accumulator[];
};

shared float partial_sums[64];

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint dword_index = gl_WorkGroupID.x * gl_WorkGroupSize.x + lane;

    const uint weight_dword = weights_packed[dword_index];
    const uint activation_dword = activations_packed[dword_index];

    const uint weight_lo4 = weight_dword & 0x0F0F0F0Fu;
    const uint weight_hi4 = (weight_dword >> 4) & 0x0F0F0F0Fu;

    float product = 0.0;
    [[unroll]] for (uint byte_index = 0; byte_index < 4; ++byte_index) {
        const float16_t activation =
            float16_t(bitfieldExtract(int(activation_dword), int(byte_index * 8u), 8));
        const float16_t weight_lo = float16_t((weight_lo4 >> (byte_index * 8u)) & 0xFu);
        const float16_t weight_hi = float16_t((weight_hi4 >> (byte_index * 8u)) & 0xFu);
        product = fma(float(weight_lo), float(activation), product);
        product = fma(float(weight_hi), float(activation), product);
    }

    partial_sums[lane] = product;
    barrier();
    if (lane == 0) {
        float workgroup_sum = 0.0;
        [[unroll]] for (uint i = 0; i < 64u; ++i) {
            workgroup_sum = workgroup_sum + partial_sums[i];
        }
        accumulator[gl_WorkGroupID.x] = workgroup_sum;
    }
}
