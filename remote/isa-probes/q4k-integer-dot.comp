#version 450

#extension GL_EXT_control_flow_attributes : require

// E2 in evidence/raven2-vulkan-kernel-census/decode-decomposition.md asks
// whether ACO selects the 24-bit multiply-add gfx902 carries
// (v_mad_u32_u24, v_mad_i32_i24) or falls back to the quarter-rate
// v_mul_lo_u32 for the integer alternative to the dequant-then-FMA family
// mul_mat_vec_q4_k.comp issues. This shader mirrors that pinned kernel's own
// structure -- one dword of packed nibbles per lane, sixteen weights of a
// superblock split into a low and a high nibble plane the way block_q4_K.qs
// packs them (see block_q4_K_packed32 in
// ggml/src/ggml-vulkan/vulkan-shaders/types.glsl), and a per-workgroup
// reduction the way reduce_result folds calc_superblock's per-thread partial
// sums -- but its accumulator stays integer end to end rather than widening
// to FLOAT_TYPE, since the product it forms is the one operation E5 in the
// same document would replace the FMA family with.
//
// The nibble planes come from a mask and a shift, matching the pinned
// kernel's own qs0_u32_lo4/qs0_u32_hi4 extraction; the int8 activation lane
// is extracted with a shift and a sign-extending bitfieldExtract rather than
// unpack8, since bitfieldExtract needs no int8 extension and the choice
// between the two extraction forms is not what this probe measures. What it
// measures is the instruction ACO chose for `nibble * activation`, read from
// the RADV_DEBUG=shaders disassembly this shader's pipeline creation prints
// on the appliance; remote/isa-probes/run-probe.c triggers that creation and
// remote/isa-probes/README.md states how to read the result.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// One dword holds eight 4-bit weights, the way a Q4_K superblock's qs array
// packs a low and a high nibble per byte over four bytes.
layout(binding = 0) readonly buffer WeightsPacked {
    uint weights_packed[];
};

// One dword holds four signed 8-bit activations, the way the q8_1 layout
// llama.cpp builds only where the driver reports an accelerated dot product
// packs a quantized activation vector.
layout(binding = 1) readonly buffer ActivationsPacked {
    uint activations_packed[];
};

// One signed accumulator per workgroup, the probe's own reduce_result.
layout(binding = 2) writeonly buffer Accumulator {
    int accumulator[];
};

shared int partial_sums[64];

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint dword_index = gl_WorkGroupID.x * gl_WorkGroupSize.x + lane;

    const uint weight_dword = weights_packed[dword_index];
    const uint activation_dword = activations_packed[dword_index];

    const uint weight_lo4 = weight_dword & 0x0F0F0F0Fu;
    const uint weight_hi4 = (weight_dword >> 4) & 0x0F0F0F0Fu;

    int product = 0;
    [[unroll]] for (uint byte_index = 0; byte_index < 4; ++byte_index) {
        const int activation = bitfieldExtract(int(activation_dword), int(byte_index * 8u), 8);
        const int nibble_lo = int((weight_lo4 >> (byte_index * 8u)) & 0xFu);
        const int nibble_hi = int((weight_hi4 >> (byte_index * 8u)) & 0xFu);
        product += nibble_lo * activation;
        product += nibble_hi * activation;
    }

    partial_sums[lane] = product;
    barrier();
    if (lane == 0) {
        int workgroup_sum = 0;
        [[unroll]] for (uint i = 0; i < 64u; ++i) {
            workgroup_sum += partial_sums[i];
        }
        accumulator[gl_WorkGroupID.x] = workgroup_sum;
    }
}
