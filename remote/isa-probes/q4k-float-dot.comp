#version 450

#extension GL_EXT_control_flow_attributes : require

// The control arm of E2 in
// evidence/raven2-vulkan-kernel-census/decode-decomposition.md: the same
// buffer layout, the same nibble extraction, and the same per-workgroup
// reduction as q4k-integer-dot.comp in this directory, over the same eight
// nibbles per lane, but the product converts both operands to float and
// accumulates through fma the way mul_mat_vec_q4_k.comp's calc_superblock
// does for its own weight-dot terms (sx, sy, sz, sw). Comparing this
// shader's RADV_DEBUG=shaders disassembly against the integer probe's is
// what isolates the instruction the integer path buys: every other
// structural choice -- workgroup size, dword-per-lane layout, nibble mask
// and shift, reduction shape -- is held fixed between the two files.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer WeightsPacked {
    uint weights_packed[];
};

layout(binding = 1) readonly buffer ActivationsPacked {
    uint activations_packed[];
};

layout(binding = 2) writeonly buffer Accumulator {
    float accumulator[];
};

shared float partial_sums[64];

void main() {
    const uint lane = gl_LocalInvocationID.x;
    const uint dword_index = gl_WorkGroupID.x * gl_WorkGroupSize.x + lane;

    const uint weight_dword = weights_packed[dword_index];
    const uint activation_dword = activations_packed[dword_index];

    const uint weight_lo4 = weight_dword & 0x0F0F0F0Fu;
    const uint weight_hi4 = (weight_dword >> 4) & 0x0F0F0F0Fu;

    float product = 0.0;
    [[unroll]] for (uint byte_index = 0; byte_index < 4; ++byte_index) {
        const float activation = float(bitfieldExtract(int(activation_dword), int(byte_index * 8u), 8));
        const float weight_lo = float((weight_lo4 >> (byte_index * 8u)) & 0xFu);
        const float weight_hi = float((weight_hi4 >> (byte_index * 8u)) & 0xFu);
        product = fma(weight_lo, activation, product);
        product = fma(weight_hi, activation, product);
    }

    partial_sums[lane] = product;
    barrier();
    if (lane == 0) {
        float workgroup_sum = 0.0;
        [[unroll]] for (uint i = 0; i < 64u; ++i) {
            workgroup_sum = workgroup_sum + partial_sums[i];
        }
        accumulator[gl_WorkGroupID.x] = workgroup_sum;
    }
}
